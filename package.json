{
  "name": "ping-parent-backend",
  "version": "1.0.0",
  "description": "Backend service for the **Ping Parent** application built with **Node.js** and **TypeScript**.",
  "main": "index.js",
  "scripts": {
    "dev": "ts-node-dev --files --respawn -r tsconfig-paths/register src/server.ts",
    "prod": "set NODE_ENV=prod && node dist/server.js",
    "build": "tsc",
    "test": "jest --runInBand --detectOpenHandles",
    "test:watch": "jest --watch",
    "prepare": "husky",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\""
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/joi": "^17.2.2",
    "@types/redis": "^4.0.10",
    "@types/socket.io": "^3.0.1",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^2.4.3",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "joi": "^18.0.2",
    "jsonwebtoken": "^9.0.0",
    "mongodb": "^7.0.0",
    "nanoid": "^3.3.11",
    "redis": "^5.10.0",
    "socket.io": "^4.8.2"
  },
  "optionalDependencies": {
    "nodemailer": "^6.9.4"
  },
  "devDependencies": {
    "@trivago/prettier-plugin-sort-imports": "^6.0.0",
    "@types/bcryptjs": "^2.4.2",
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.2",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.0.1",
    "@types/nodemailer": "^7.0.4",
    "@types/supertest": "^2.0.12",
    "@typescript-eslint/eslint-plugin": "^8.50.1",
    "@typescript-eslint/parser": "^8.50.1",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "husky": "^9.1.7",
    "jest": "^29.6.1",
    "lint-staged": "^16.2.7",
    "prettier": "^3.7.4",
    "supertest": "^7.1.4",
    "ts-jest": "^29.1.0",
    "ts-node-dev": "^2.0.0",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3"
  },
  "lint-staged": {
    "*.ts": [
      "prettier --write",
      "eslint --fix"
    ]
  }
}
