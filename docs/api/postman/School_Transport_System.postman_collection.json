        {
          "name": "Register School Admin",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@school.com\",\n  \"password\": \"SecurePass123\",\n  \"school_id\": \"SCHOOL123\",\n  \"phone_number\": \"+919876543210\",\n  \"name\": \"School Admin Name\"\n}"
            },
            "url": {
              "raw": "{{BASE_URL}}/api/v1/school/auth/register",
              "host": ["{{BASE_URL}}"],
              "path": ["api", "v1", "school", "auth", "register"]
