{
  "info": {
    "name": "Razorpay Payment API",
    "description": "Ping Parent Backend - Razorpay Payment Integration",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{parent_jwt_token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "1. Get Configuration",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/razorpay/config",
          "host": ["{{base_url}}"],
          "path": ["razorpay", "config"]
        },
        "description": "Get Razorpay Key ID for frontend integration. No authentication required."
      },
      "response": []
    },
    {
      "name": "2. Create Order",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"amount\": 500,\n  \"currency\": \"INR\",\n  \"subscription_id\": \"sub_123\",\n  \"description\": \"Monthly subscription\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/razorpay/orders",
          "host": ["{{base_url}}"],
          "path": ["razorpay", "orders"]
        },
        "description": "Create a new Razorpay order for payment. Amount should be in rupees (will be converted to paise on backend). Requires parent authentication."
      },
      "response": []
    },
    {
      "name": "3. Verify and Complete Payment",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"razorpay_order_id\": \"order_1A2B3C4D5E6F\",\n  \"razorpay_payment_id\": \"pay_1X2Y3Z4W5V6U\",\n  \"razorpay_signature\": \"9ef4dffbfd84f1318f6739a3ce19f9d85851857ae648f114332d8401e0949a3d\",\n  \"payment_id\": \"507f1f77bcf86cd799439011\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/razorpay/verify",
          "host": ["{{base_url}}"],
          "path": ["razorpay", "verify"]
        },
        "description": "Verify Razorpay payment signature and complete payment after successful checkout. Payment_id is the internal payment record ID. Requires parent authentication."
      },
      "response": []
    },
    {
      "name": "4. Capture Payment",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"payment_id\": \"pay_1X2Y3Z4W5V6U\",\n  \"amount\": 500\n}"
        },
        "url": {
          "raw": "{{base_url}}/razorpay/capture",
          "host": ["{{base_url}}"],
          "path": ["razorpay", "capture"]
        },
        "description": "Capture a previously authorized payment. Amount should be in rupees. Requires parent authentication."
      },
      "response": []
    },
    {
      "name": "5. Refund Payment (Full)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"payment_id\": \"pay_1X2Y3Z4W5V6U\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/razorpay/refunds",
          "host": ["{{base_url}}"],
          "path": ["razorpay", "refunds"]
        },
        "description": "Refund a payment in full. Requires parent authentication."
      },
      "response": []
    },
    {
      "name": "6. Refund Payment (Partial)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"payment_id\": \"pay_1X2Y3Z4W5V6U\",\n  \"amount\": 250,\n  \"notes\": {\n    \"reason\": \"Partial return\"\n  }\n}"
        },
        "url": {
          "raw": "{{base_url}}/razorpay/refunds",
          "host": ["{{base_url}}"],
          "path": ["razorpay", "refunds"]
        },
        "description": "Refund a payment partially. Amount should be in rupees (optional, full refund if not provided). Requires parent authentication."
      },
      "response": []
    },
    {
      "name": "7. Get Order Details",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/razorpay/orders/{{order_id}}",
          "host": ["{{base_url}}"],
          "path": ["razorpay", "orders", "{{order_id}}"]
        },
        "description": "Fetch details of a specific Razorpay order by order ID. Requires parent authentication."
      },
      "response": []
    },
    {
      "name": "8. Get Payment Details",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/razorpay/payments/{{payment_id}}",
          "host": ["{{base_url}}"],
          "path": ["razorpay", "payments", "{{payment_id}}"]
        },
        "description": "Fetch details of a specific Razorpay payment by payment ID. Requires parent authentication."
      },
      "response": []
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:3000/api",
      "type": "string"
    },
    {
      "key": "parent_jwt_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "order_id",
      "value": "order_1A2B3C4D5E6F",
      "type": "string"
    },
    {
      "key": "payment_id",
      "value": "pay_1X2Y3Z4W5V6U",
      "type": "string"
    }
  ]
}
