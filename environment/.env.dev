PORT=3000
MONGO_URI=mongodb+srv://astriagk_db:252318@development.jzywvar.mongodb.net/?appName=development
DB_NAME=ping-parent-dev
JWT_SECRET=your_jwt_secret_key
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_EXPIRES_IN=7d
NODE_ENV=dev

# Storage Configuration
# Choose storage provider: local | s3 | digitalocean | wasabi | minio
STORAGE_PROVIDER=local

# For local storage - no additional config needed, files saved in /uploads

# For AWS S3 (Production)
# STORAGE_REGION=us-east-1
# STORAGE_ACCESS_KEY=your_aws_key
# STORAGE_SECRET_KEY=your_aws_secret
# STORAGE_BUCKET_NAME=your-bucket-name

# Razorpay Payment Gateway Configuration (Development/Testing)
# Use actual credentials from .env.dev.local (not committed to git)
RAZORPAY_KEY_ID=rzp_test_dummy_key_id
RAZORPAY_KEY_SECRET=dummy_razorpay_secret

# Optional: Razorpay Webhook Secret (if implementing webhooks)
# Get from: https://dashboard.razorpay.com/app/webhooks
# RAZORPAY_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxx

TOMTOM_API_KEY=dummy_tomtom_api_key

# Twilio Configuration for SMS Verification (Development/Testing)
# Use actual credentials from .env.dev.local (not committed to git)
TWILIO_ACCOUNT_SID=AC_dummy_account_sid_placeholder
TWILIO_AUTH_TOKEN=dummy_auth_token_placeholder
TWILIO_VERIFY_SERVICE_SID=VA_dummy_verify_service_sid