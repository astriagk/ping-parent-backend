PORT=3000
MONGO_URI=mongodb+srv://astriagk_db:252318@development.jzywvar.mongodb.net/?appName=development
DB_NAME=ping-parent-dev
JWT_SECRET=your_jwt_secret_key
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_EXPIRES_IN=7d
NODE_ENV=dev

# Storage Configuration
# Choose storage provider: local | s3 | digitalocean | wasabi | minio
STORAGE_PROVIDER=local

# For local storage - no additional config needed, files saved in /uploads

# For DigitalOcean Spaces (Development/Production)
# STORAGE_ENDPOINT=https://nyc3.digitaloceanspaces.com
# STORAGE_REGION=nyc3
# STORAGE_ACCESS_KEY=your_do_spaces_key
# STORAGE_SECRET_KEY=your_do_spaces_secret
# STORAGE_BUCKET_NAME=your-bucket-name

# For AWS S3 (Production)
# STORAGE_REGION=us-east-1
# STORAGE_ACCESS_KEY=your_aws_key
# STORAGE_SECRET_KEY=your_aws_secret
# STORAGE_BUCKET_NAME=your-bucket-name

# For Wasabi (Production)
# STORAGE_ENDPOINT=https://s3.us-east-1.wasabisys.com
# STORAGE_REGION=us-east-1
# STORAGE_ACCESS_KEY=your_wasabi_key
# STORAGE_SECRET_KEY=your_wasabi_secret
# STORAGE_BUCKET_NAME=your-bucket-name

# For MinIO (Local Development Alternative)
# STORAGE_ENDPOINT=http://localhost:9000
# STORAGE_REGION=us-east-1
# STORAGE_ACCESS_KEY=minioadmin
# STORAGE_SECRET_KEY=minioadmin
# STORAGE_BUCKET_NAME=driver-documents
