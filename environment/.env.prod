PORT=3000
MONGO_URI=your_production_mongodb_uri
DB_NAME=ping-parent-prod
JWT_SECRET=your_strong_jwt_secret_key
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_EXPIRES_IN=7d
NODE_ENV=production

# Storage Configuration - Use DigitalOcean Spaces or AWS S3 for production
# Choose storage provider: s3 | digitalocean | wasabi | minio
STORAGE_PROVIDER=digitalocean

# ===== PRODUCTION - DigitalOcean Spaces (Recommended) =====
# STORAGE_ENDPOINT=https://nyc3.digitaloceanspaces.com
# STORAGE_REGION=nyc3
# STORAGE_ACCESS_KEY=your_production_do_key
# STORAGE_SECRET_KEY=your_production_do_secret
# STORAGE_BUCKET_NAME=your-production-bucket-name

# ===== PRODUCTION - AWS S3 =====
# STORAGE_PROVIDER=s3
# STORAGE_REGION=us-east-1
# STORAGE_ACCESS_KEY=your_production_aws_key
# STORAGE_SECRET_KEY=your_production_aws_secret
# STORAGE_BUCKET_NAME=your-production-bucket-name

# ===== PRODUCTION - Wasabi =====
# STORAGE_PROVIDER=wasabi
# STORAGE_ENDPOINT=https://s3.us-east-1.wasabisys.com
# STORAGE_REGION=us-east-1
# STORAGE_ACCESS_KEY=your_production_wasabi_key
# STORAGE_SECRET_KEY=your_production_wasabi_secret
# STORAGE_BUCKET_NAME=your-production-bucket-name

FIREBASE_SERVICE_ACCOUNT_PATH=./environment/firebase-service-account.json
