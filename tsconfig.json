{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "rootDir": "src",
    "outDir": "dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node", "jest"],
    "typeRoots": ["./node_modules/@types", "./src/types"],
    "baseUrl": "./src",
    "paths": {
      "@services": ["services/index"],
      "@controllers/*": ["controllers/*"],
      "@utils": ["utils/index"],
      "@constants": ["constants/index"],
      "@config": ["config/index"],
      "@middlewares": ["middlewares/index"],
      "@models": ["types/index"],
      "@routes/*": ["routes/*"],
      "@db/*": ["db/*"],
      "@repositories": ["repositories/index"]
    }
  },
  "include": ["src/**/*"]
}
