{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "rootDir": "src",
    "outDir": "dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node", "jest"],
    "baseUrl": "./src",
    "paths": {
      "@services": ["services/index"],
      "@controllers/*": ["controllers/*"],
      "@utils": ["utils/index"],
      "@constants": ["constants/index"],
      "@config/*": ["config/*"],
      "@middleware/*": ["middleware/*"],
      "@models": ["types/index"],
      "@routes/*": ["routes/*"],
      "@db/*": ["db/*"]
    }
  },
  "include": ["src"]
}
