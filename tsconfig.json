{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "rootDir": "src",
    "outDir": "dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node", "jest"],
    "baseUrl": "./src",
    "paths": {
      "@services/*": ["services/*"],
      "@controllers/*": ["controllers/*"],
      "@utils/*": ["utils/*"],
      "@constants/*": ["constants/*"],
      "@config/*": ["config/*"],
      "@middleware/*": ["middleware/*"],
      "@models/*": ["types/*"],
      "@routes/*": ["routes/*"],
      "@db/*": ["db/*"]
    }
  }
}
