<mxfile host="app.diagrams.net">
  <diagram name="Driver Workflow">
    <mxGraphModel dx="1400" dy="1000" grid="1" gridSize="10">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- ==================== START ==================== -->
        <mxCell id="start" value="Start" style="ellipse;fillColor=#dae8fc;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="300" y="20" width="100" height="50" as="geometry"/>
        </mxCell>

        <!-- ==================== ONBOARDING PHASE ==================== -->
        <mxCell id="phase_onboard" value="ONBOARDING" style="text;fontStyle=1;fontSize=14;fillColor=none;fontColor=#666666" vertex="1" parent="1">
          <mxGeometry x="20" y="90" width="120" height="30" as="geometry"/>
        </mxCell>

        <mxCell id="login" value="Login via Phone + OTP&#xa;(users table — user_type=driver)" style="rounded=1;fillColor=#fff2cc;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="240" y="100" width="220" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="e1" edge="1" parent="1" source="start" target="login">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="profile" value="Complete Driver Profile&#xa;name, email, photo, vehicle_type,&#xa;vehicle_number, vehicle_capacity&#xa;(drivers table)" style="rounded=1;fillColor=#e1d5e7" vertex="1" parent="1">
          <mxGeometry x="220" y="190" width="260" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="e2" edge="1" parent="1" source="login" target="profile">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="address" value="Add Address&#xa;address, city, state, lat/long&#xa;(driver_addresses)" style="rounded=1;fillColor=#e1d5e7" vertex="1" parent="1">
          <mxGeometry x="220" y="290" width="260" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="e3" edge="1" parent="1" source="profile" target="address">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="documents" value="Upload Documents&#xa;driving_license, vehicle_license, insurance&#xa;(driver_documents)" style="rounded=1;fillColor=#e1d5e7" vertex="1" parent="1">
          <mxGeometry x="220" y="380" width="260" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="e4" edge="1" parent="1" source="address" target="documents">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- ==================== APPROVAL GATE ==================== -->
        <mxCell id="approval_wait" value="Wait for Admin Approval&#xa;approval_status = pending" style="rounded=1;fillColor=#f8cecc;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="220" y="470" width="260" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="e5" edge="1" parent="1" source="documents" target="approval_wait">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="approval_check" value="Approved?" style="rhombus;fillColor=#f8cecc;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="290" y="550" width="120" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="e6" edge="1" parent="1" source="approval_wait" target="approval_check">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="rejected" value="Rejected&#xa;(rejection_reason provided)&#xa;Fix &amp; Resubmit" style="rounded=1;fillColor=#f8cecc" vertex="1" parent="1">
          <mxGeometry x="520" y="550" width="200" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="e7" value="No" edge="1" parent="1" source="approval_check" target="rejected">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e7b" edge="1" parent="1" source="rejected" target="documents" style="edgeStyle=orthogonalEdgeStyle;dashed=1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- ==================== DASHBOARD PHASE ==================== -->
        <mxCell id="phase_active" value="ACTIVE DRIVER" style="text;fontStyle=1;fontSize=14;fillColor=none;fontColor=#666666" vertex="1" parent="1">
          <mxGeometry x="20" y="660" width="140" height="30" as="geometry"/>
        </mxCell>

        <mxCell id="dashboard" value="Driver Dashboard&#xa;(driver_unique_id shared with parents)" style="rounded=1;fillColor=#d5e8d4;fontStyle=1;fontSize=13" vertex="1" parent="1">
          <mxGeometry x="230" y="670" width="240" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="e8" value="Yes" edge="1" parent="1" source="approval_check" target="dashboard">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- ==================== ASSIGNMENTS ==================== -->
        <mxCell id="assignments" value="View Student Assignments&#xa;(from parents or school)&#xa;driver_student_assignments" style="rounded=1;fillColor=#dae8fc" vertex="1" parent="1">
          <mxGeometry x="20" y="760" width="260" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="e9" edge="1" parent="1" source="dashboard" target="assignments">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="accept_reject" value="Accept / Reject Assignment&#xa;assignment_status →&#xa;active or inactive" style="rounded=1;fillColor=#fff2cc" vertex="1" parent="1">
          <mxGeometry x="20" y="850" width="260" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="e10" edge="1" parent="1" source="assignments" target="accept_reject">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- ==================== TRIP LIFECYCLE ==================== -->
        <mxCell id="phase_trip" value="TRIP LIFECYCLE" style="text;fontStyle=1;fontSize=14;fillColor=none;fontColor=#666666" vertex="1" parent="1">
          <mxGeometry x="380" y="750" width="140" height="30" as="geometry"/>
        </mxCell>

        <mxCell id="trip_type" value="Trip Type?" style="rhombus;fillColor=#fff2cc;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="400" y="790" width="130" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="e11" edge="1" parent="1" source="dashboard" target="trip_type">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- PICKUP FLOW (Morning) -->
        <mxCell id="pickup_label" value="PICKUP (Morning)" style="text;fontStyle=3;fontSize=12;fillColor=none;fontColor=#007700" vertex="1" parent="1">
          <mxGeometry x="560" y="770" width="150" height="25" as="geometry"/>
        </mxCell>

        <mxCell id="start_pickup" value="Start Pickup Trip&#xa;trips (trip_type=pickup)&#xa;trip_status = started" style="rounded=1;fillColor=#d5e8d4" vertex="1" parent="1">
          <mxGeometry x="560" y="800" width="250" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="e12" value="pickup" edge="1" parent="1" source="trip_type" target="start_pickup">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="pickup_location" value="Send Live Location&#xa;location_tracking&#xa;(lat, long, speed, heading)" style="rounded=1;fillColor=#dae8fc" vertex="1" parent="1">
          <mxGeometry x="560" y="890" width="250" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="e13" edge="1" parent="1" source="start_pickup" target="pickup_location">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="pickup_stops" value="At Each Student Home:&#xa;bulk-stop-action (OTP required)&#xa;→ pickup_status = PICKED&#xa;→ pickup_time, lat/long recorded&#xa;trip_students, daily_qr_otp" style="rounded=1;fillColor=#f8cecc;fontStyle=0" vertex="1" parent="1">
          <mxGeometry x="560" y="980" width="280" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="e14" edge="1" parent="1" source="pickup_location" target="pickup_stops">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="pickup_school" value="At School:&#xa;bulk-school-action (NO OTP)&#xa;→ PICKED students → DROPPED&#xa;→ drop_time, drop_lat/long" style="rounded=1;fillColor=#d5e8d4" vertex="1" parent="1">
          <mxGeometry x="560" y="1090" width="280" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="e15" edge="1" parent="1" source="pickup_stops" target="pickup_school">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- DROP FLOW (Evening) -->
        <mxCell id="drop_label" value="DROP (Evening)" style="text;fontStyle=3;fontSize=12;fillColor=none;fontColor=#770000" vertex="1" parent="1">
          <mxGeometry x="140" y="920" width="150" height="25" as="geometry"/>
        </mxCell>

        <mxCell id="start_drop" value="Start Drop Trip&#xa;trips (trip_type=drop)&#xa;trip_status = started" style="rounded=1;fillColor=#d5e8d4" vertex="1" parent="1">
          <mxGeometry x="100" y="950" width="240" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="e16" value="drop" edge="1" parent="1" source="trip_type" target="start_drop">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="drop_school" value="At School:&#xa;bulk-school-action (NO OTP)&#xa;→ PENDING students → PICKED&#xa;→ pickup_time, pickup_lat/long" style="rounded=1;fillColor=#d5e8d4" vertex="1" parent="1">
          <mxGeometry x="100" y="1040" width="260" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="e17" edge="1" parent="1" source="start_drop" target="drop_school">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="drop_location" value="Send Live Location&#xa;location_tracking" style="rounded=1;fillColor=#dae8fc" vertex="1" parent="1">
          <mxGeometry x="100" y="1140" width="260" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="e18" edge="1" parent="1" source="drop_school" target="drop_location">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="drop_stops" value="At Each Student Home:&#xa;bulk-stop-action (OTP required)&#xa;→ PICKED → DROPPED&#xa;→ drop_time, drop_lat/long&#xa;trip_students, daily_qr_otp" style="rounded=1;fillColor=#f8cecc" vertex="1" parent="1">
          <mxGeometry x="100" y="1220" width="260" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="e19" edge="1" parent="1" source="drop_location" target="drop_stops">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- ==================== COMPLETE TRIP ==================== -->
        <mxCell id="complete" value="Complete Trip&#xa;trip_status = completed&#xa;total_trips incremented" style="rounded=1;fillColor=#d5e8d4;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="300" y="1340" width="250" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="e20" edge="1" parent="1" source="pickup_school" target="complete">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e21" edge="1" parent="1" source="drop_stops" target="complete">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- ==================== POST-TRIP ==================== -->
        <mxCell id="notifications" value="Receive Notifications&#xa;(assignment updates, trip alerts)&#xa;notifications" style="rounded=1;fillColor=#e1d5e7" vertex="1" parent="1">
          <mxGeometry x="560" y="1200" width="250" height="60" as="geometry"/>
        </mxCell>

        <mxCell id="ratings" value="View Ratings &amp; Reviews&#xa;from parents&#xa;ratings_reviews → drivers.rating" style="rounded=1;fillColor=#e1d5e7" vertex="1" parent="1">
          <mxGeometry x="560" y="1290" width="250" height="60" as="geometry"/>
        </mxCell>

        <!-- Back to dashboard -->
        <mxCell id="e_back" value="Next Trip" edge="1" parent="1" source="complete" target="dashboard" style="edgeStyle=orthogonalEdgeStyle;dashed=1;strokeColor=#999999">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- END -->
        <mxCell id="end" value="End" style="ellipse;fillColor=#dae8fc;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="370" y="1440" width="100" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="e_end" edge="1" parent="1" source="complete" target="end">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- ==================== LEGEND ==================== -->
        <mxCell id="legend_title" value="LEGEND" style="text;fontStyle=1;fontSize=14;fillColor=none" vertex="1" parent="1">
          <mxGeometry x="880" y="20" width="100" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="l1" value="Auth / Decision" style="rounded=1;fillColor=#fff2cc;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="880" y="55" width="150" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="l2" value="Profile / Setup" style="rounded=1;fillColor=#e1d5e7;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="880" y="90" width="150" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="l3" value="Trip Actions" style="rounded=1;fillColor=#d5e8d4;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="880" y="125" width="150" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="l4" value="Location / Data" style="rounded=1;fillColor=#dae8fc;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="880" y="160" width="150" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="l5" value="OTP / Verification" style="rounded=1;fillColor=#f8cecc;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="880" y="195" width="150" height="30" as="geometry"/>
        </mxCell>

        <!-- ==================== FLOW NOTES ==================== -->
        <mxCell id="note1" value="PICKUP Flow (Morning):&#xa;Driver Home → Student Homes (OTP) → School (no OTP)&#xa;&#xa;DROP Flow (Evening):&#xa;School (no OTP) → Student Homes (OTP) → Driver Home&#xa;&#xa;Route optimized by lat/long (optimized_route_data)" style="shape=note;fillColor=#ffffcc;strokeColor=#999;fontSize=11;whiteSpace=wrap;align=left;spacingLeft=8" vertex="1" parent="1">
          <mxGeometry x="880" y="260" width="320" height="120" as="geometry"/>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>