<mxfile host="app.diagrams.net">
  <diagram name="Admin Workflow">
    <mxGraphModel dx="1800" dy="1200" grid="1" gridSize="10">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- ==================== START ==================== -->
        <mxCell id="start" value="Start" style="ellipse;fillColor=#dae8fc;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="360" y="20" width="100" height="50" as="geometry"/>
        </mxCell>

        <!-- ==================== LOGIN ==================== -->
        <mxCell id="login" value="Admin Login&#xa;(admin_portal)" style="rounded=1;fillColor=#fff2cc;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="310" y="100" width="200" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="e_start_login" edge="1" parent="1" source="start" target="login">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- ==================== ROLE DECISION ==================== -->
        <mxCell id="role" value="Role?" style="rhombus;fillColor=#f8cecc;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="340" y="180" width="140" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="e_login_role" edge="1" parent="1" source="login" target="role">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- ========================================================================== -->
        <!-- ==================== SUPERADMIN BRANCH (LEFT) ==================== -->
        <!-- ========================================================================== -->
        <mxCell id="super" value="Super Admin Dashboard" style="rounded=1;fillColor=#d5e8d4;fontStyle=1;fontSize=13" vertex="1" parent="1">
          <mxGeometry x="20" y="300" width="240" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="e_role_super" value="superadmin" edge="1" parent="1" source="role" target="super">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- SA: Manage Admins -->
        <mxCell id="sa_manage_admins" value="Manage Admins&#xa;(Create admin, school_admin)&#xa;admin_portal" style="rounded=1;fillColor=#dae8fc" vertex="1" parent="1">
          <mxGeometry x="20" y="390" width="240" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="e_super_admins" edge="1" parent="1" source="super" target="sa_manage_admins">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- SA: Manage Schools -->
        <mxCell id="sa_manage_schools" value="Manage Schools&#xa;(CRUD schools)&#xa;schools" style="rounded=1;fillColor=#dae8fc" vertex="1" parent="1">
          <mxGeometry x="20" y="480" width="240" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="e_super_schools" edge="1" parent="1" source="sa_manage_admins" target="sa_manage_schools">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- SA: Manage Subscription Plans -->
        <mxCell id="sa_sub_plans" value="Manage Subscription Plans&#xa;(monthly, quarterly, yearly)&#xa;subscription_plans" style="rounded=1;fillColor=#dae8fc" vertex="1" parent="1">
          <mxGeometry x="20" y="570" width="240" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="e_super_plans" edge="1" parent="1" source="sa_manage_schools" target="sa_sub_plans">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- SA: Approve/Reject Drivers -->
        <mxCell id="sa_approve_drivers" value="Approve / Reject Drivers&#xa;(Review docs, set approval_status)&#xa;drivers, driver_documents" style="rounded=1;fillColor=#fff2cc" vertex="1" parent="1">
          <mxGeometry x="20" y="660" width="240" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="e_super_drivers" edge="1" parent="1" source="sa_sub_plans" target="sa_approve_drivers">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- SA: Manage Ads -->
        <mxCell id="sa_ads" value="Manage Ads&#xa;(banner, interstitial, native_card)&#xa;ads, ad_interactions" style="rounded=1;fillColor=#e1d5e7" vertex="1" parent="1">
          <mxGeometry x="20" y="750" width="240" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="e_super_ads" edge="1" parent="1" source="sa_approve_drivers" target="sa_ads">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- SA: View Audit Logs -->
        <mxCell id="sa_audit" value="View Audit Logs&#xa;audit_logs" style="rounded=1;fillColor=#e1d5e7" vertex="1" parent="1">
          <mxGeometry x="20" y="840" width="240" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="e_super_audit" edge="1" parent="1" source="sa_ads" target="sa_audit">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- SA: Manage Support Tickets -->
        <mxCell id="sa_support" value="Manage Support Tickets&#xa;support_tickets" style="rounded=1;fillColor=#e1d5e7" vertex="1" parent="1">
          <mxGeometry x="20" y="920" width="240" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="e_super_support" edge="1" parent="1" source="sa_audit" target="sa_support">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- SA: Assign Roles -->
        <mxCell id="sa_roles" value="Assign User Roles&#xa;roles, user_roles" style="rounded=1;fillColor=#e1d5e7" vertex="1" parent="1">
          <mxGeometry x="20" y="1000" width="240" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="e_super_roles" edge="1" parent="1" source="sa_support" target="sa_roles">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- ========================================================================== -->
        <!-- ==================== ADMIN BRANCH (CENTER) ==================== -->
        <!-- ========================================================================== -->
        <mxCell id="admin_dash" value="Admin Dashboard" style="rounded=1;fillColor=#d5e8d4;fontStyle=1;fontSize=13" vertex="1" parent="1">
          <mxGeometry x="300" y="300" width="220" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="e_role_admin" value="admin" edge="1" parent="1" source="role" target="admin_dash">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Admin: Approve/Reject Drivers -->
        <mxCell id="a_approve_drivers" value="Approve / Reject Drivers&#xa;(Review docs, set approval_status)&#xa;drivers, driver_documents" style="rounded=1;fillColor=#fff2cc" vertex="1" parent="1">
          <mxGeometry x="300" y="390" width="220" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="e_admin_drivers" edge="1" parent="1" source="admin_dash" target="a_approve_drivers">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Admin: Manage Schools -->
        <mxCell id="a_schools" value="Manage Schools&#xa;schools" style="rounded=1;fillColor=#dae8fc" vertex="1" parent="1">
          <mxGeometry x="300" y="480" width="220" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="e_admin_schools" edge="1" parent="1" source="a_approve_drivers" target="a_schools">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Admin: Create School Admins -->
        <mxCell id="a_school_admins" value="Create School Admins&#xa;admin_portal (school_admin role)" style="rounded=1;fillColor=#dae8fc" vertex="1" parent="1">
          <mxGeometry x="300" y="560" width="220" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="e_admin_school_admins" edge="1" parent="1" source="a_schools" target="a_school_admins">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Admin: Manage Ads -->
        <mxCell id="a_ads" value="Manage Ads&#xa;ads" style="rounded=1;fillColor=#e1d5e7" vertex="1" parent="1">
          <mxGeometry x="300" y="640" width="220" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="e_admin_ads" edge="1" parent="1" source="a_school_admins" target="a_ads">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Admin: Support Tickets -->
        <mxCell id="a_support" value="Manage Support Tickets&#xa;support_tickets" style="rounded=1;fillColor=#e1d5e7" vertex="1" parent="1">
          <mxGeometry x="300" y="720" width="220" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="e_admin_support" edge="1" parent="1" source="a_ads" target="a_support">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- ========================================================================== -->
        <!-- ==================== SCHOOL ADMIN BRANCH (RIGHT) ==================== -->
        <!-- ========================================================================== -->
        <mxCell id="school_dash" value="School Admin Dashboard&#xa;(school_id scoped)" style="rounded=1;fillColor=#d5e8d4;fontStyle=1;fontSize=13" vertex="1" parent="1">
          <mxGeometry x="580" y="300" width="260" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="e_role_school" value="school_admin" edge="1" parent="1" source="role" target="school_dash">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- School: Manage School Subscription -->
        <mxCell id="sch_sub" value="Manage School Subscription&#xa;school_subscriptions" style="rounded=1;fillColor=#fff2cc" vertex="1" parent="1">
          <mxGeometry x="580" y="390" width="260" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="e_school_sub" edge="1" parent="1" source="school_dash" target="sch_sub">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- School: Generate Student Codes -->
        <mxCell id="sch_codes" value="Generate Student Redemption Codes&#xa;(SCHSTDCD prefix)&#xa;school_student_codes" style="rounded=1;fillColor=#fff2cc" vertex="1" parent="1">
          <mxGeometry x="580" y="470" width="260" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="e_school_codes" edge="1" parent="1" source="sch_sub" target="sch_codes">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- School: Assign Drivers to Students -->
        <mxCell id="sch_assign" value="Assign Drivers to Students&#xa;(assignment_source = school)&#xa;driver_student_assignments" style="rounded=1;fillColor=#dae8fc" vertex="1" parent="1">
          <mxGeometry x="580" y="560" width="260" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="e_school_assign" edge="1" parent="1" source="sch_codes" target="sch_assign">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- School: Create Events -->
        <mxCell id="sch_events" value="Create School Events&#xa;(sports, holiday, exam, etc.)&#xa;school_events" style="rounded=1;fillColor=#e1d5e7" vertex="1" parent="1">
          <mxGeometry x="580" y="650" width="260" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="e_school_events" edge="1" parent="1" source="sch_assign" target="sch_events">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- School: View RSVPs -->
        <mxCell id="sch_rsvp" value="View Event RSVPs&#xa;event_rsvp" style="rounded=1;fillColor=#e1d5e7" vertex="1" parent="1">
          <mxGeometry x="580" y="740" width="260" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="e_school_rsvp" edge="1" parent="1" source="sch_events" target="sch_rsvp">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- School: Moderate Community -->
        <mxCell id="sch_moderate" value="Moderate Community Board&#xa;(pin/hide posts, comments)&#xa;community_posts, community_post_comments" style="rounded=1;fillColor=#f8cecc" vertex="1" parent="1">
          <mxGeometry x="580" y="820" width="260" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="e_school_moderate" edge="1" parent="1" source="sch_rsvp" target="sch_moderate">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- School: Send Notifications -->
        <mxCell id="sch_notify" value="Send Notifications to Parents&#xa;notifications" style="rounded=1;fillColor=#f8cecc" vertex="1" parent="1">
          <mxGeometry x="580" y="910" width="260" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="e_school_notify" edge="1" parent="1" source="sch_moderate" target="sch_notify">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- ==================== LEGEND ==================== -->
        <mxCell id="legend_title" value="LEGEND" style="text;fontStyle=1;fontSize=14;fillColor=none" vertex="1" parent="1">
          <mxGeometry x="900" y="20" width="100" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="legend1" value="Auth / Decision" style="rounded=1;fillColor=#fff2cc;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="900" y="55" width="150" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="legend2" value="Dashboard" style="rounded=1;fillColor=#d5e8d4;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="900" y="90" width="150" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="legend3" value="CRUD Actions" style="rounded=1;fillColor=#dae8fc;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="900" y="125" width="150" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="legend4" value="Secondary Actions" style="rounded=1;fillColor=#e1d5e7;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="900" y="160" width="150" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="legend5" value="Moderation / Alerts" style="rounded=1;fillColor=#f8cecc;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="900" y="195" width="150" height="30" as="geometry"/>
        </mxCell>

        <!-- ==================== HIERARCHY NOTE ==================== -->
        <mxCell id="note_hierarchy" value="Creation Hierarchy:&#xa;superadmin → admin, school_admin&#xa;admin → school_admin only&#xa;school_admin → scoped to own school_id" style="shape=note;fillColor=#ffffcc;strokeColor=#999;fontSize=11;whiteSpace=wrap;align=left;spacingLeft=8" vertex="1" parent="1">
          <mxGeometry x="900" y="260" width="260" height="80" as="geometry"/>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>